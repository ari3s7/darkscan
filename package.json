{
  "name": "darkscan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @darkscan/rules && npm run build -w @darkscan/server && npm run build -w @darkscan/web",
    "dev:server": "npm run dev -w @darkscan/server",
    "dev:web": "npm run dev -w @darkscan/web",
    "db:migrate": "npm run db:migrate -w @darkscan/server",
    "demo": "node demo/server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
