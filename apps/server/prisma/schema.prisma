generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Scan {
  id        String     @id @default(cuid())
  url       String
  status    ScanStatus @default(PENDING)
  error     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  pages     Page[]
  journeys  Journey[]
}

model Page {
  id             String    @id @default(cuid())
  scanId         String
  scan           Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url            String
  finalUrl       String?
  title          String?
  statusCode     Int?
  screenshotPath String?
  error          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  findings       Finding[]
  journeySteps   JourneyStep[]

  @@index([scanId])
}

model Finding {
  id        String     @id @default(cuid())
  pageId    String
  page      Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ruleId    String
  severity  String?
  summary       String
  journeyStepId String?
  journeyStep   JourneyStep? @relation(fields: [journeyStepId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  evidence      Evidence[]

  @@index([pageId])
  @@index([ruleId])
  @@index([journeyStepId])
}

model Journey {
  id        String        @id @default(cuid())
  scanId    String
  scan      Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type      String
  status    String
  actions   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  steps     JourneyStep[]

  @@unique([scanId, type])
  @@index([scanId])
}

model JourneyStep {
  id             String    @id @default(cuid())
  journeyId      String
  journey        Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  pageId         String?
  page           Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  position       Int
  pageKind       String
  actionLabel    String?
  actionSelector String?
  actionType     String?
  findings       Finding[]

  @@index([journeyId])
  @@index([pageId])
}

model Evidence {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type      String
  content   Json
  createdAt DateTime @default(now())

  @@index([findingId])
}
