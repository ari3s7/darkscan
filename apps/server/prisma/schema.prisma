generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Scan {
  id        String     @id @default(cuid())
  url       String
  status    ScanStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  pages     Page[]
}

model Page {
  id         String    @id @default(cuid())
  scanId     String
  scan       Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url        String
  finalUrl   String?
  title      String?
  statusCode Int?
  metadata   Json?
  createdAt  DateTime  @default(now())
  findings   Finding[]

  @@index([scanId])
}

model Finding {
  id        String     @id @default(cuid())
  pageId    String
  page      Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ruleId    String
  severity  String?
  summary   String
  createdAt DateTime   @default(now())
  evidence  Evidence[]

  @@index([pageId])
  @@index([ruleId])
}

model Evidence {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type      String
  content   Json
  createdAt DateTime @default(now())

  @@index([findingId])
}
